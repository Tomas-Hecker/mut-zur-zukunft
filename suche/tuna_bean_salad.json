imedia.org/wikipedia/commons/thumb/1/15/The_Gary_schools%3B_a_general_account_%281918%29_%2814800062283%29.jpg/500px-The_Gary_schools%3B_a_general_account_%281918%29_%2814800062283%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":400,"height":227,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/15/The_Gary_schools%3B_a_general_account_%281918%29_%2814800062283%29.jpg/960px-The_Gary_schools%3B_a_general_account_%281918%29_%2814800062283%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/1/15/The_Gary_schools%3B_a_general_account_%281918%29_%2814800062283%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:The_Gary_schools;_a_general_account_(1918)_(14800062283).jpg","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/43697104","extmetadata":{"DateTime":{"value":"2015-09-27 11:26:23","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"The Gary schools; a general account (1918) (14800062283)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"1918 books|Schools in Gary, Indiana|Photos uploaded from Flickr by F\u00e6 using a script|Flickr images reviewed by FlickreviewR|Files from Internet Archive Book Images Flickr stream|Files from Flickr's 'The Commons'","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"<br>\n<p><b>Identifier</b>: garyschoolsgener00flex (<a class=\"external text\" href=\"https://commons.wikimedia.org/w/index.php?title=Special%3ASearch&amp;profile=default&amp;fulltext=Search&amp;search=insource%3A%2Fgaryschoolsgener00flex%2F\">find matches</a>)<br>\n<b>Title</b>: <a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/internetarchivebookimages/tags/bookidgaryschoolsgener00flex\">The Gary schools; a general account</a><br>\n<b>Year</b>: <a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/internetarchivebookimages/tags/bookyear1918\">1918</a> (<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/internetarchivebookimages/tags/bookdecade1910\">1910s</a>)<br>\n<b>Authors</b>:  <a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/internetarchivebookimages/tags/bookauthorFlexner__Abraham__1866_1959\">Flexner, Abraham, 1866-1959</a> <a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/internetarchivebookimages/tags/bookauthorBachman__Frank_Puterbaugh__1871_\">Bachman, Frank Puterbaugh, 1871-</a> <a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/internetarchivebookimages/tags/bookauthorGeneral_education_board\">General education board</a><br>\n<b>Subjects</b>:  <a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/internetarchivebookimages/tags/booksubjectGary_Public_Schools\">Gary Public Schools</a> <a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/internetarchivebookimages/tags/booksubjectEducational_surveys\">Educational surveys</a><br>\n<b>Publisher</b>:  <a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/internetarchivebookimages/tags/bookpublisherNew_York___General_education_board\">New York\u00a0: General education board</a><br>\n<b>Contributing Library</b>:  <a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/internetarchivebookimages/tags/bookcontributorUniversity_of_California_Libraries\">University of California Libraries</a><br>\n<b>Digitizing Sponsor</b>:  <a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/internetarchivebookimages/tags/booksponsorInternet_Archive\">Internet Archive</a><br>\n<br>\n<b>View Book Page</b>: <a rel=\"nofollow\" class=\"external text\" href=\"https://archive.org/stream/garyschoolsgener00flex/garyschoolsgener00flex#page/n185/mode/1up\">Book Viewer</a><br>\n<b>About This Book</b>: <a rel=\"nofollow\" class=\"external text\" href=\"https://archive.org/details/garyschoolsgener00flex\">Catalog Entry</a><br>\n<b>View All Images</b>: <a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/internetarchivebookimages/tags/bookidgaryschoolsgener00flex\">All Images From Book</a><br>\nClick here to <a rel=\"nofollow\" class=\"external text\" href=\"https://archive.org/stream/garyschoolsgener00flex/garyschoolsgener00flex#page/n185/mode/1up\"><b>view book online</b></a> to see this illustration in context in a browseable online version of this book.<br>\n<br>\n<b>Text Appearing Before Image:</b><br>\n<i>or any one school. More-over, the year of the survey chanced to be one of unusualdisorganization. The teacher at Froebel had been in thesystem only since September and was preparing to leave,as was also the instructor at Emerson. Teacherschanged at Jefferson during the spring, and at Glen Parkall cooking gave way in April to gardening, while atBeveridge nothing more than the preparation of theschool luncheon has ever been attempted. However,effort was being made\u2014at least at the Emerson, Froebel,Jefferson, and Glen Park schools\u2014to meet the minimumelementary, and at Emerson and Froebel the minimumhigh school, requirements of the State Department ofPubhc Instruction. Beyond these minimum require-ments, each teacher is free to plan and to execute suchdaily tasks as in her judgment are calculated to meetlocal and individual needs. The preparation of food for the cafeteria forms thebasis of the Gary work whether of elementary or highschool grade. There are no cooking laboratories other</i><br>\n<b>Text Appearing After Image:</b><br>\n<i>p^ HOUSEHOLD ARTS 141 than those employed in the preparation of the noonluncheon. The same equipment is used by both ele-mentary and high school students and the same instruc-tor directs both groups. The children help to preparethe food, set the tables, and do the serving, the olderpupils being held responsible for the more difficult tasks.Under these conditions, the content of the cookinginstruction can be best inferred from typical menus: MONDAY Cream of tomato soupBoiled hamBaked potatoesTuna fish saladTomato saladCup cakePeach dumplings TUESDAY Roast porkSweet potatoesStewed tomatoesCabbage saladBrown bettyChocolate cream WEDXESDAY Lima bean soupRoast beefBoiled potatoesBanana saladWashington pieStewed prunes THURSDAY Hot roast beef sandwichesScalloped meatSteamed cabbageHam sandwichOrange saladMarble cakeSteamed puddingLemon cookies It is possible to cover the field by means of variedmenus quite as thoroughly as by means of definitelyorganized courses, provided the teacher keeps</i><br>\n<br>\n<b>Note About Images</b><br>\n</p>\n<i>Please note that these images are extracted from scanned page images that may have been digitally enhanced for readability - coloration and appearance of these illustrations may not perfectly resemble the original work.</i>","source":"commons-desc-page"},"DateTimeOriginal":{"value":"1918","source":"commons-desc-page"},"Credit":{"value":"<p><a rel=\"nofollow\" class=\"external free\" href=\"https://www.flickr.com/photos/internetarchivebookimages/14800062283/\">https://www.flickr.com/photos/internetarchivebookimages/14800062283/</a>\n</p>\n<ul><li>Source book page: <a rel=\"nofollow\" class=\"external free\" href=\"https://archive.org/stream/garyschoolsgener00flex/garyschoolsgener00flex#page/n185/mode/1up\">https://archive.org/stream/garyschoolsgener00flex/garyschoolsgener00flex#page/n185/mode/1up</a></li></ul>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/126377022@N07\">Internet Archive Book Images</a>","source":"commons-desc-page"},"Permission":{"value":"At the time of upload, the image license was automatically confirmed using the Flickr <a href=\"https://en.wikipedia.org/wiki/API\" class=\"extiw\" title=\"en:API\">API</a>. For more information see <a href=\"//commons.wikimedia.org/wiki/User:F%C3%A6/Flickr_API_detail\" title=\"User:F\u00e6/Flickr API detail\">Flickr API detail</a>.","source":"commons-desc-page","hidden":""},"LicenseShortName":{"value":"No restrictions","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"No known copyright restrictions","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://www.flickr.com/commons/usage/","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""}}}]},"163926746":{"pageid":163926746,"ns":6,"title":"File:Tuna Salad with sweet corn.jpg","index":1,"imagerepository":"local","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e7/Tuna_Salad_with_sweet_corn.jpg/500px-Tuna_Salad_with_sweet_corn.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":400,"thumbheight":533,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e7/Tuna_Salad_with_sweet_corn.jpg/960px-Tuna_Salad_with_sweet_corn.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e7/Tuna_Salad_with_sweet_corn.jpg/500px-Tuna_Salad_with_sweet_corn.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":400,"height":533,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e7/Tuna_Salad_with_sweet_corn.jpg/960px-Tuna_Salad_with_sweet_corn.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/e/e7/Tuna_Salad_with_sweet_corn.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Tuna_Salad_with_sweet_corn.jpg","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/163926746","extmetadata":{"DateTime":{"value":"2025-04-21 16:45:46","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Tuna Salad with sweet corn","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"CC-Zero|Tuna salad|Self-published work|Files with coordinates missing SDC location of creation|Images from Wiki Loves Africa 2025|Images from Wiki Loves Africa 2025 in Cameroon","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"GPSLatitude":{"value":"5.253856","source":"commons-desc-page"},"GPSLongitude":{"value":"-3.932550","source":"commons-desc-page"},"GPSMapDatum":{"value":"WGS-84","source":"commons-desc-page","hidden":""},"ImageDescription":{"value":"Ingredients:\n<p>Typically includes canned tuna, mayonnaise, and often additions like celery, onion, pickles, or relish. \n</p><p>Variations:\nMany recipes exist, with options to add ingredients such as capers, olives, apples, or different herbs, grains and spices. This particular Recipe contains beans, sweet corn and sweet peas.\n</p><p>Serving:\nIt can be served in sandwiches, on crackers, lettuce, tomatoes, or avocados, or enjoyed on its own.\n</p><p>Customization:\nMayonnaise can be substituted with Greek yogurt for a healthier version. \n</p><p>Preparation:\nIt is quick and easy to make, often involving mixing the ingredients in a bowl. \nFlavor Enhancements:\nSome recipes suggest adding a splash of fish sauce or minced anchovy for a savory flavor. \n</p><p>Storage:\n</p>\nLeftovers can be stored in an airtight container in the refrigerator for up to 3 days.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2025-03-18 14:58:09","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Adesolive\" title=\"User:Adesolive\">Adesolive</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Zero, Public Domain Dedication","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc0","source":"commons-templates","hidden":""}}}]}}}}