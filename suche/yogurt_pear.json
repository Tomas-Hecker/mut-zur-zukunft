{"batchcomplete":"","query":{"pages":{"17799671":{"pageid":17799671,"ns":6,"title":"File:20111012-FNCS-LSC-0242 - Flickr - USDAgov.jpg","index":8,"imagerepository":"local","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/06/20111012-FNCS-LSC-0242_-_Flickr_-_USDAgov.jpg/500px-20111012-FNCS-LSC-0242_-_Flickr_-_USDAgov.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":400,"thumbheight":265,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/06/20111012-FNCS-LSC-0242_-_Flickr_-_USDAgov.jpg/960px-20111012-FNCS-LSC-0242_-_Flickr_-_USDAgov.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/06/20111012-FNCS-LSC-0242_-_Flickr_-_USDAgov.jpg/500px-20111012-FNCS-LSC-0242_-_Flickr_-_USDAgov.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":400,"height":265,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/06/20111012-FNCS-LSC-0242_-_Flickr_-_USDAgov.jpg/960px-20111012-FNCS-LSC-0242_-_Flickr_-_USDAgov.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/0/06/20111012-FNCS-LSC-0242_-_Flickr_-_USDAgov.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:20111012-FNCS-LSC-0242_-_Flickr_-_USDAgov.jpg","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/17799671","extmetadata":{"DateTime":{"value":"2011-12-25 22:32:05","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"20111012-FNCS-LSC-0242 - Flickr - USDAgov","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Taken with Nikon D7000|PD USDA|Flickr images reviewed by FlickreviewR|Files from U.S. Department of Agriculture Flickr stream|Photographs by the U.S. Department of Agriculture with bad file names|Nottingham Elementary School, meal program","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"The deli display for the school lunch program at Nottingham Elementary School in Arlington, VA, on Wednesday, October 12, 2011. It contains, 100% juice packets, organic soy milk, nonfat yogurt, turkey wraps, pita wedges, farm fresh mixed lettuce salad, whole wheat bread sandwiches, Asian pears, and bottled water. Today's menu also included roasted chicken, roasted butternut squash with dried cranberries, hot muffins, and more.  USDA Photo by Lance Cheung.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2011-10-12 10:38","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/usdagov/6238939683/\">20111012-FNCS-LSC-0242</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/41284017@N08\">U.S. Department of Agriculture</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}}}]},"138738384":{"pageid":138738384,"ns":6,"title":"File:Food sources of magnesium (magnesium-rich foods).jpg","index":9,"imagerepository":"local","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/be/Food_sources_of_magnesium_%28magnesium-rich_foods%29.jpg/500px-Food_sources_of_magnesium_%28magnesium-rich_foods%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":400,"thumbheight":578,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/b/be/Food_sources_of_magnesium_%28magnesium-rich_foods%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/be/Food_sources_of_magnesium_%28magnesium-rich_foods%29.jpg/500px-Food_sources_of_magnesium_%28magnesium-rich_foods%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":400,"height":578,"srcset":"https://upload.wikimedia.org/wikipedia/commons/b/be/Food_sources_of_magnesium_%28magnesium-rich_foods%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/b/be/Food_sources_of_magnesium_%28magnesium-rich_foods%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Food_sources_of_magnesium_(magnesium-rich_foods).jpg","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/138738384","extmetadata":{"DateTime":{"value":"2023-10-11 23:11:13","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Food sources of magnesium (magnesium-rich foods)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Self-published work|Magnesium in biology and medicine|Nutrition information charts","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"About 97.2% of foods contained magnesium. On the basis of the proposed method, the average (%) of foods containing appropriate magnesium levels in food groups was 13.81%, of which 10.7% was the average of magnesium source (good source of magnesium) foods, and 3.11% was the average of high magnesium (excellent source of magnesium) foods. Legumes and legume products with 64.84%, nut and seed products with 54.41%, baby foods with 53.7%, breakfast cereals with 35.34%, and cereal grains and pasta with 32.04% had the highest averages of foods containing appropriate magnesium levels. Foods containing appropriate magnesium levels were not found in five food groups (beef products; fats and oils; pork products; sausages and luncheon meats; spices and herbs) and were few in 11 food groups (fast foods; lamb, veal, and game products; poultry products; baked products; fruits and fruit juices; soups, sauces, and gravies; sweets; restaurant foods; dairy and egg products; meals, entrees, and side dishes; beverages).\n<p>The highest amounts of magnesium were found in breakfast cereal (made with bran, germ, or whole grain containing an appropriate magnesium level), snail, lambsquarters, hemp seeds, conch, soybean curd cheese, pumpkin and squash seeds, watermelon seed kernels, protein shake (magnesium-fortified), meat extender, papad, moth beans, fireweed leaves, cottonseed kernels, whey protein powder isolate, yardlong beans, whelk, leafy tips of bitter gourd, prickly pears, peanut butter (magnesium-fortified), flaxseed, rice bran, oat bran muffins, dock, cottonseed meal, spinach, Brazil nuts, Swiss chard, amaranth grain, cottonseed flour, nutrition shake (magnesium-fortified), sesame seeds, hyacinth beans, safflower seed kernels, chinook salmon, buckwheat, white and wild rice mix, chia seeds, soybeans, sunflower seed butter, formulated bar (made with whole grain, nut, legume, soy or whey protein, or chocolate containing an appropriate magnesium level), yellow beans, lima beans, Sisymbrium sp. seeds, spinach spaghetti, mungo beans, wheat bran, Piki bread made from blue cornmeal, quinoa, almond butter, white beans, cashew nuts, chili with beans, almonds, rose hips, pink beans, chocolate instant breakfast drink (magnesium-fortified), pili nuts, teff, cashew butter, oats, wild rice, black bean soup, buckwheat pancakes, buckwheat flour, sesame crunch, scotch kale, sorghum, Atlantic mackerel, Atlantic Pollock, French beans, whole wheat pasta, beaked hazelnuts, lupin beans, pine nuts, common ling, cowpeas, tempeh, spelt, cocoa-rich chocolate (at least 70% cocoa solids), chocolate yogurt, tofu yogurt, fava beans, great northern beans, mung beans, durum wheat, medium-grain brown rice, pigeon peas, Indian buffalo milk, and yellow rice with seasoning.\n</p>\n<b>Suggested citation:</b> Forouzesh, Abed; Forouzesh, Fatemeh; Samadi Foroushani, Sadegh; Forouzesh, Abolfazl. A new method for calculating magnesium content and determining appropriate magnesium levels in foods. SSRN 2022. DOI: <a rel=\"nofollow\" class=\"external text\" href=\"https://papers.ssrn.com/sol3/papers.cfm?abstract_id=4133396\">10.2139/ssrn.4133396</a>","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2022-06-16","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>. <a class=\"external text\" href=\"https://upload.wikimedia.org/wikipedia/commons/3/33/Food_sources_of_magnesium_%28magnesium-rich_foods%29.pdf\">Click Here</a> to download a high resolution figure.","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/w/index.php?title=User:SSamadi15&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"User:SSamadi15 (page does not exist)\">SSamadi15</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 4.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution-Share Alike 4.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/4.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-sa-4.0","source":"commons-templates","hidden":""}}}]},"19551149":{"pageid":19551149,"ns":6,"title":"File:Fruktsallad (Fruit salad).jpg","index":4,"imagerepository":"local","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/74/Fruktsallad_%28Fruit_salad%29.jpg/500px-Fruktsallad_%28Fruit_salad%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":400,"thumbheight":300,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/74/Fruktsallad_%28Fruit_salad%29.jpg/960px-Fruktsallad_%28Fruit_salad%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/74/Fruktsallad_%28Fruit_salad%29.jpg/500px-Fruktsallad_%28Fruit_salad%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":400,"height":300,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/74/Fruktsallad_%28Fruit_salad%29.jpg/960px-Fruktsallad_%28Fruit_salad%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/7/74/Fruktsallad_%28Fruit_salad%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Fruktsallad_(Fruit_salad).jpg","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/19551149","extmetadata":{"DateTime":{"value":"2012-07-09 16:53:02","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Fruktsallad (Fruit salad)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":